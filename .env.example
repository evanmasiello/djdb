# Environment configuration
DEBUG=false
LOG_LEVEL=INFO

# Paths (optional, defaults to ~/.djdb)
# LIBRARY_DIR=/path/to/music/library
# DB_PATH=/custom/path/to/djdb.db

# API
API_HOST=127.0.0.1
API_PORT=8000

# Audio
AUDIO_SAMPLE_RATE=16000
CHUNK_SIZE=4096

# Embeddings
DEFAULT_EMBEDDING_MODEL=laion/larger_clap
EMBEDDING_DIMENSION=512

# Search
DEFAULT_TOP_K=50
MAX_TOP_K=1000

# External APIs (optional - get these from provider websites)
# AUDD_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here
# ANTHROPIC_API_KEY=your_key_here
